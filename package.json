{
  "name": "fota-backend",
  "version": "1.0.0",
  "description": "FOTA (Firmware Over-The-Air) Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "cross-env NODE_ENV=development node dist/index.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/index.js",
    "start:production": "cross-env NODE_ENV=production node dist/index.js"
  },
  "keywords": [
    "fota",
    "backend",
    "express",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "cross-env": "^10.1.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
